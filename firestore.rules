rules_version = '2';

// ============================================================
// ShareAZ Firestore セキュリティルール（暫定版 / B案）
// ------------------------------------------------------------
// 方針：
//   - テストモード（誰でも読み書き可・30日で失効）からの卒業が目的
//   - 「ログイン済みユーザーのみ全データを読み書き可」という最小ルール
//   - 外部からの匿名アクセスは完全に遮断される
//   - 社内ユーザー間の改ざん（role/azCoins書き換え等）は防げない
//     → 次フェーズ（スレッド機能完成後）で本格ルール化する予定
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // すべてのコレクション・サブコレクションに適用
    // request.auth が null（未ログイン）なら deny
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
